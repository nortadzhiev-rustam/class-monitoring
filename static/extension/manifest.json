{
  "manifest_version": 3,
  "name": "ClassMonitor Web Filter",
  "version": "0.1.0",
  "description": "Applies your teacher's website rules during class. Works together with the ClassMonitor Student app.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "permissions": ["declarativeNetRequest", "nativeMessaging", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    { "resources": ["blocked.html", "blocked.css", "blocked.js"], "matches": ["<all_urls>"] }
  ]
}
